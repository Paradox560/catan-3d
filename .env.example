# npm start/dev load an ignored .env. Hosting environment values take precedence.
NODE_ENV=production
PORT=3001
CATAN_DATA_DIR=./server/data
# Set firestore on Vercel; file works locally without Firebase.
RANKINGS_STORAGE=file

# Firebase Console > Project settings > Your apps > Web config.
# Vercel uses its deployment identity after the one-time setup in docs/VERCEL.md.
# No backend Firebase account or downloaded private key is required.
# FIREBASE_AUTH_MODE=web
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=inventory-management-6626b.firebaseapp.com
# FIREBASE_PROJECT_ID=inventory-management-6626b
# FIREBASE_APP_ID=
# Optional fields from the same config:
# FIREBASE_STORAGE_BUCKET=
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_MEASUREMENT_ID=
# FIREBASE_DATABASE_URL=
# Alternatively set FIREBASE_CONFIG to the complete web config as valid JSON.
# Choose JSON or individual public fields, not both.

# These defaults need no extra configuration on Vercel:
# RANKINGS_STORAGE=firestore (automatic on Vercel when unset)
# FIRESTORE_RANKINGS_DOCUMENT=catan/rankings
# FIRESTORE_DATABASE_ID=(default)

# Website owner login. Both required; password >=10 characters.
# RANKINGS_ADMIN_USERNAME=
# RANKINGS_ADMIN_PASSWORD=
ALLOWED_ORIGINS=

# Legacy deployments can still select FIREBASE_AUTH_MODE=admin and supply ONE of:
# GOOGLE_APPLICATION_CREDENTIALS (private file path), FIREBASE_SERVICE_ACCOUNT_JSON.
# Remove those variables in web mode. Never prefix backend secrets with VITE_.
# See docs/VERCEL.md for the one-time Vercel deployment permission setup.
