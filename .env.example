# Browser rankings: standard Firebase Console web config (public identifiers).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=inventory-management-6626b.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=inventory-management-6626b
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# No owner password, owner UID, service account, or backend account is needed here.
# Enable Firebase Authentication Email/Password and configure your UID in the rules.
# See docs/VERCEL.md. Redeploy after changing VITE_ values.

# Optional legacy local Node rankings (not the Vercel rankings page):
# VITE_RANKINGS_TRANSPORT=http
# RANKINGS_STORAGE=file
# RANKINGS_ADMIN_USERNAME=
# RANKINGS_ADMIN_PASSWORD=

# Local Node server:
NODE_ENV=production
PORT=3001
CATAN_DATA_DIR=./server/data
ALLOWED_ORIGINS=

# Online multiplayer is a separate trusted backend. Existing server variables
# remain server-only; see docs/MULTIPLAYER_BACKEND.md. Never expose server
# passwords, session tokens, or service-account keys with a VITE_ prefix.
