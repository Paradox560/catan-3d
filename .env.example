# npm start and npm run dev load .env when present. Hosting environment variables
# take precedence. Copy this template to .env before configuring local secrets.
NODE_ENV=production
PORT=3001

# Must be writable by the server process. Live rooms and file-backed rankings use this.
# Mount persistent storage here to retain those files in production.
CATAN_DATA_DIR=./server/data

# Keep local JSON storage until Firebase credentials are configured.
RANKINGS_STORAGE=file

# To store rankings in Firebase, change RANKINGS_STORAGE to firestore and uncomment:
# FIREBASE_PROJECT_ID=inventory-management-6626b
# FIRESTORE_RANKINGS_DOCUMENT=catan/rankings
# FIRESTORE_DATABASE_ID=(default)
# Provide ONE credential source, kept outside Git:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/private/path/firebase-service-account.json
# Or set FIREBASE_SERVICE_ACCOUNT_JSON to the downloaded JSON as a hosting secret.
# Google-managed runtimes can instead use their assigned service identity (ADC).
# See docs/FIRESTORE.md. Do not use VITE_ variables for server credentials.

# Optional, comma-separated exact origins, with scheme and without trailing slashes.
# Same-origin browser connections are allowed by default.
# Example: https://catan.example.com,https://your-service.onrender.com
ALLOWED_ORIGINS=

# Shared rankings are public to read. Only the owner password can authorize edits.
# Required for production Firestore; recommended for all hosted deployments.
# Set a unique password of at least 10 characters as a secret on your hosting provider.
# Keep this line commented until you supply a password. Never commit a real password.
# RANKINGS_ADMIN_PASSWORD=
