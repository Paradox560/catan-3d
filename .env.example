# Public Firebase Console web config. On Vercel use Config type for these fields.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=inventory-management-6626b.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=inventory-management-6626b
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Server-only owner login. On Vercel use Secret type. Never add a VITE_ prefix.
RANKINGS_ADMIN_USERNAME=
RANKINGS_ADMIN_PASSWORD=
# Password must contain at least ten characters.

# Durable server storage for rankings, owner sessions and Vercel online rooms.
RANKINGS_STORAGE=firestore
FIREBASE_AUTH_MODE=admin
FIREBASE_PROJECT_ID=inventory-management-6626b
FIRESTORE_RANKINGS_DOCUMENT=catan/rankings
# On Vercel use Secret type and paste the existing service-account JSON contents.
# FIREBASE_SERVICE_ACCOUNT_JSON=
# Locally, you may instead set GOOGLE_APPLICATION_CREDENTIALS to its file path.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/your-existing-credential.json
# Keep the unused credential line commented out: even a blank active JSON value
# conflicts with GOOGLE_APPLICATION_CREDENTIALS. Never configure both sources.
# Do not commit credential files or real .env files.

# Local Node server:
NODE_ENV=development
# Vercel sets production itself; use production on other public hosts.
PORT=3001
CATAN_DATA_DIR=./server/data
ALLOWED_ORIGINS=
# Optional local file-only rankings: VITE_RANKINGS_TRANSPORT=http and
# RANKINGS_STORAGE=file. Build again after changing VITE_ values.
# Firebase Authentication, owner UID rules and WIF setup are not required.
# See docs/VERCEL.md. Redeploy after changing environment variables.
