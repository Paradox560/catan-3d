# The server reads environment variables; it does not automatically load .env.
# After copying to .env, use:
# node --env-file=.env --import tsx server/index.ts
NODE_ENV=production
PORT=3001

# Must be writable by the server process. Mount persistent storage here in production.
CATAN_DATA_DIR=./server/data

# Optional, comma-separated exact origins, with scheme and without trailing slashes.
# Same-origin browser connections are allowed by default.
# Example: https://catan.example.com,https://your-service.onrender.com
ALLOWED_ORIGINS=
