// Merge the Catan match into your existing rules; preserve other apps' matches.
// Replace the placeholder with the dedicated backend user's Firebase Authentication UID.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /catan/rankings/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == 'REPLACE_WITH_BACKEND_UID';
    }
  }
}
