// Merge these exact Catan matches into your EXISTING rules; preserve unrelated
// inventory/application matches. Do not replace your entire ruleset with this file.
// A broader matching allow still wins: remove broad grants that expose private
// Catan records or permit direct client writes. Owner edits use the server API.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /catan/rankings {
      allow get: if true;
    }
    match /catan/rankings/players/{playerId} {
      allow get, list: if true;
    }
    match /catan/rankings/games/{gameId} {
      allow get, list: if true;
    }
    // No browser writes are granted, including for signed-in Firebase users.
    // No browser access to onlineRooms, onlineLimits, ownerSessions,
    // ownerRateLimits, access/owner or nested player/game subcollections.
    // Firebase Admin SDK operations use the server's private IAM credential.

    // Preserve unrelated application matches here when merging into your rules.
  }
}
