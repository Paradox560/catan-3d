// Merge this scoped match into the existing rules; preserve unrelated apps' matches.
// The Vercel backend uses Google IAM through Workload Identity Federation.
// Browser clients use the Catan API and require no direct Firestore access.
// A broader matching allow still wins: exclude this subtree from broad client grants.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /catan/rankings/{document=**} {
      allow read, write: if false;
    }
    // Preserve the rules for other applications here; do not replace them with this template.
  }
}
