{
  "name": "catan-3d",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:dev": "node --test scripts/dev.test.mjs",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "test:server": "node --import tsx server/smoke.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "test:rankings": "VITE_RANKINGS_TRANSPORT=http npm run build && node --import tsx server/rankings.smoke.ts && playwright test --config=playwright.rankings.config.ts",
    "rankings:import": "node --env-file-if-exists=.env --import tsx server/rankings-import.ts",
    "test:firestore": "node --import tsx server/firestore.smoke.ts",
    "test:online-http": "node --import tsx server/online.smoke.ts",
    "test:online-browser": "VITE_ONLINE_TRANSPORT=http npm run build && playwright test --config=playwright.http.config.ts",
    "test:firebase-web": "node --import tsx server/firebase-web.smoke.ts",
    "test:firebase-setup": "node --test scripts/setup-vercel-firestore.test.mjs",
    "firebase:browser:rules": "node scripts/prepare-browser-rules.mjs",
    "test:firebase-browser": "node --import tsx tests/firebase-browser.smoke.ts",
    "test:firebase-browser-ui": "playwright test --config=playwright.firebase.config.ts"
  },
  "dependencies": {
    "@vercel/oidc": "^3.8.9",
    "express": "^5.2.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "three": "^0.180.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.3",
    "prettier": "^3.9.9",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.13.6"
    }
  }
}
